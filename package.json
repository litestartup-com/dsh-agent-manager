{
  "name": "ohdsh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Oh! dsh (ohdsh.com) -- dsh agents manager: personal / small-team AI middle platform on top of DeepSeek Harness and dsh-api-gateway",
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "init": "tsx src/cli/init.ts",
    "nodes": "tsx src/cli/node.ts",
    "backfill-cost": "tsx src/cli/backfill-cost.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^10.1.3",
    "@node-rs/argon2": "^2.0.2",
    "better-sqlite3": "^11.7.0",
    "croner": "^9.0.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "eventsource-parser": "^3.0.0",
    "fastify": "^5.2.0",
    "simple-git": "^3.27.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
