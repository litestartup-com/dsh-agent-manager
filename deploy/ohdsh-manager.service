[Unit]
Description=Oh! dsh manager (dsh-agent-manager)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__APP_ROOT__
ExecStart=__NODE_BIN__ dist/index.js
Restart=on-failure
RestartSec=3
# 不设 NODE_ENV：production 会开启 secureCookies，无 TLS 时登录失效；
# 上 HTTPS 之后再加 Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
