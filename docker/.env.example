# 复制为 .env 并填写（.env 不进 git）

# 网关 API 密钥（外部调用 /api-gw/v1/proxy/* 时带在 X-API-Key 头）
# 生成方式：openssl rand -hex 32
GW_KEY=

# DeepSeek 模型密钥（容器内 DSH 使用；不填则容器里模型不可用）
DEEPSEEK_API_KEY=

# agent 工作区根（宿主机绝对路径；manager 的 agent.workspace 也写这个值）
WORKSPACE_PATH=

# 宿主机部署用户的 uid/gid（容器同 uid 运行，挂载目录读写一致）
# 可用 id -u / id -g 查询；默认 1000
HOST_UID=1000
HOST_GID=1000
