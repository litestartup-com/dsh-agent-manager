# 复制为 .env 后填写真值。.env 已被 .gitignore 排除。

# ── 会话 cookie 签名密钥 ────────────────────────────────
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── 首次启动创建的管理员账号 ────────────────────────────
# 库里没有任何用户时才生效。留空则自动生成随机密码并打印到日志一次。
MANAGER_USERNAME=admin
MANAGER_INITIAL_PASSWORD=

# ── dsh-api-gateway 的静态密钥 ──────────────────────────
# 必须与 DSH 里 gateway 设置的 apiKeys 数组中的某一项完全一致。
# 同时把 gateway 的 allowKeyProvision 设为 false。
GW_KEY_A=
GW_KEY_B=
# 蜂群 P0：GW_KEY_A 同时用于 endpoint 的 sandbox_key_ref（按会话沙箱模式路由）。

# ── 蜂群 P2：主脑内部 API 令牌 ────────────────────────
# 主脑（DSH 里的 skill+curl）调 manager 内部 API 用；路由只接受 127.0.0.1。
# 生成：node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
BRAIN_TOKEN=

# ── 可选 ────────────────────────────────────────────────
# LOG_LEVEL=info
# NODE_ENV=development
